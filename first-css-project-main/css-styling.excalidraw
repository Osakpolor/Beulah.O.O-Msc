      "updated": 1786391085746,
      "link": null,
      "locked": false,
      "text": "- External CSS preferred => separates concerns - reusable\n- Internal => fine for a single page demo\n- Inline => avoid inline styling => cannot be reused , hard to audit",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- External CSS preferred => separates concerns - reusable\n- Internal => fine for a single page demo\n- Inline => avoid inline styling => cannot be reused , hard to audit",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hgAKfIpZYw0486js7nNQA",
      "type": "text",
      "x": 367.39082546784135,
      "y": 619.1345093777716,
